@using System.ComponentModel.DataAnnotations;

<div class="flex flex-col">
    <div class="flex gap-3">
        <div class="" @onclick="AddService">
            <Icon Type="plus" Theme="IconThemeType.Outline" />
        </div>
        
        <Icon Type="close" Theme="IconThemeType.Outline" />
        <Icon Type="check" Theme="IconThemeType.Outline" />
    </div>
    <div>

    </div>
</div>

<Modal Title="添加服务节点" @bind-Visible="@_visible">
    <div class="flex flex-col gap-3">
        <RadioGroup @bind-Value="@type">
            <Radio Value="@("单轴")">单轴</Radio>
            <Radio Value="@("轴组")">轴组</Radio>
            <Radio Value="@("夹爪")">夹爪</Radio>
        </RadioGroup>
        @if (type == "单轴")
        {
            <Form Model="@axis">
                <FormItem Label="选择电机协议">
                    <SimpleSelect DefaultValue="DSP402" Style="width:120px;">
                        <SelectOptions>
                            <SimpleSelectOption Value="DSP402" Label="DSP402"></SimpleSelectOption>
                            <SimpleSelectOption Value="RS485" Label="RS485"></SimpleSelectOption>
                        </SelectOptions>
                    </SimpleSelect>
                </FormItem>
                <FormItem Label="CAN通道">
                    <Input @bind-Value="@context.protocol" />
                </FormItem>
                <FormItem Label="选择canopen通讯方式">
                    <SimpleSelect DefaultValue="DSP402" Style="width:120px;">
                        <SelectOptions>
                            <SimpleSelectOption Value="DSP402" Label="DSP402"></SimpleSelectOption>
                            <SimpleSelectOption Value="RS485" Label="RS485"></SimpleSelectOption>
                        </SelectOptions>
                    </SimpleSelect>
                </FormItem>
                <FormItem Label="服务路径">
                    <Input @bind-Value="@context.protocol" />
                </FormItem>
            </Form>
        }
        else if (type == "轴组")
        {
            <Form Model="@axisGroup">
                <FormItem Label="选择电机协议">
                    <SimpleSelect DefaultValue="DSP402" Style="width:120px;">
                        <SelectOptions>
                            <SimpleSelectOption Value="DSP402" Label="DSP402"></SimpleSelectOption>
                            <SimpleSelectOption Value="RS485" Label="RS485"></SimpleSelectOption>
                        </SelectOptions>
                    </SimpleSelect>
                </FormItem>
            </Form>
        }
        else if (type == "夹爪")
        {
            <Form Model="@axisGroup">
                <FormItem Label="选择电机协议">
                    <SimpleSelect DefaultValue="DSP402" Style="width:120px;">
                        <SelectOptions>
                            <SimpleSelectOption Value="DSP402" Label="DSP402"></SimpleSelectOption>
                            <SimpleSelectOption Value="RS485" Label="RS485"></SimpleSelectOption>
                        </SelectOptions>
                    </SimpleSelect>
                </FormItem>
            </Form>
        }
    </div>
</Modal>

@code{
    bool _visible = false;

    string type = "单轴";

    public class Axis
    {
        [Required]
        public string protocol;

        [Required]
        public int canChannel;

        [Required]
        public int id;

        [Required]
        public string canopenMode;

        [Required]
        public string deviceName;

        [Required]
        public string servicePath;

        


    }

    public class AxisGroup
    {
        [Required]
        public string protocol;

        [Required]
        public string servicePath;

        [Required]
        public int CompositeNumber = 1;
    }

    public class Grapper
    {
        [Required]
        public string protocol;

        [Required]
        public int comPort;

        [Required]
        public string servicePath;
    }

    Axis axis = new();
    AxisGroup axisGroup = new();

    private void AddService()
    {
        _visible = !_visible;
    }
}